# drfatemeheidari.ir — dynamic PHP site (cPanel/Apache)

Options -Indexes
DirectoryIndex index.php index.html

# ---------- Pretty redirects ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Legacy static URLs → PHP pages
  RewriteRule ^index\.html$ index.php [L,R=301]
  RewriteRule ^qrcode\.html$ qrcode.php [L,R=301]

  # (Front controller intentionally not used; every page is a real PHP file.)
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# ---------- Never serve secrets / internals ----------
# Works whether the whole project was uploaded to the web root (option B)
# or only /public was uploaded (option A).
<FilesMatch "(\.env|config\.env|\.sql|\.md|composer\.(json|lock)|Dockerfile|docker-compose\.yml)$">
  Require all denied
</FilesMatch>

# Application code must never be web-readable if it ended up inside the docroot.
RedirectMatch 403 ^/app/
RedirectMatch 403 ^/storage/
RedirectMatch 403 ^/docker/
RedirectMatch 403 ^/new-plan/

# ---------- Performance: long-lived static assets ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
