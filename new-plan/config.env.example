# ============================================================
# drfatemeheidari.ir — dynamic site configuration
# Copy to config.env and adjust per environment.
# On cPanel this file lives OUTSIDE public_html (next to app/).
# ============================================================

# --- General ---
APP_DEBUG=0
SITE_DOMAIN=drfatemeheidari.ir

# --- MySQL (cPanel: localhost + cPanel-prefixed names) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=fh_site
DB_USER=fh_user
DB_PASS=change-me-please

# --- Admin panel (used once by install.php) ---
ADMIN_USER=drfateme
ADMIN_PASS=change-me-min-8-chars

# --- Installer key (run install.php once with this key, then it self-locks) ---
INSTALL_KEY=change-me-random-key

# --- Appointment endpoint (relative to site root) ---
APPOINTMENT_ENDPOINT=api/appointment.php

# ============ FTP deploy (deploy.sh) ============
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_SECURE=true            # FTPS (explicit TLS) — recommended
FTP_PUBLIC_DIR=public_html # web root on the server
FTP_APP_DIR=app            # folder next to public_html for app/ + config.env (kept private)
